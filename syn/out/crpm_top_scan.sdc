set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design crpm_top

create_clock -name "clk_ref" -period 10.0 -waveform {0.0 5.0} [get_ports clk_ref_i]
set_clock_transition 0.1 [get_clocks clk_ref]
